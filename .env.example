# Contact email for the SEC EDGAR User-Agent header (required by SEC).
SEC_CONTACT_EMAIL=you@example.com
# Optional. Leave empty to run the agent with the deterministic rule-based planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# "hf" uses sentence-transformers/all-MiniLM-L6-v2; "hashing" is an offline fallback used by tests/CI.
EMBED_BACKEND=hf
# Leave empty to use an embedded persistent Chroma at .chroma/; set to use a Chroma server.
CHROMA_HOST=
CHROMA_PORT=8000
